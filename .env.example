# Postgres connection string from your Vercel Storage (Neon) integration.
# Vercel usually injects this automatically once you add the Postgres storage
# add-on to this project — check Project Settings > Environment Variables
# for the exact name Vercel gave it (often DATABASE_URL or POSTGRES_URL) and
# make sure this file's key matches what your code expects.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
